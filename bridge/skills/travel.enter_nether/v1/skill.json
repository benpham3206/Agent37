{
  "name": "travel.enter_nether",
  "version": 1,
  "implementation": { "type": "code", "artifact": "index.js", "entry_point": "run" },
  "requirements": {
    "description": "Approach a nearby lit portal on level ground and remain in its interior until the observed dimension is the_nether.",
    "input": {}
  },
  "success_check": {
    "time_limit_ms": 30000,
    "condition": { "path": "facts.dimension", "equals": "the_nether" },
    "failure_conditions": ["death", "execution_error", "human_takeover", "requirement_unmet"]
  },
  "reset_steps": [
    { "command": "execute in minecraft:overworld run tp {username} 1.5 64 -3.5", "verify": { "path": "self.position", "equals": { "x": 1.5, "y": 64, "z": -3.5 } } },
    { "command": "gamemode survival {username}", "verify": { "path": "facts.dimension", "equals": "overworld" } },
    { "command": "fill -4 63 -6 7 63 5 minecraft:stone", "verify": { "path": "facts.nearest_blocks.stone.type", "equals": "stone" } },
    { "command": "fill -4 64 -6 7 68 5 minecraft:air", "verify": { "path": "facts.dimension", "equals": "overworld" } },
    { "command": "fill 0 63 0 3 67 0 minecraft:obsidian", "verify": { "path": "facts.nearest_blocks.obsidian.type", "equals": "obsidian" } },
    { "command": "fill 1 64 0 2 66 0 minecraft:nether_portal[axis=x]", "verify": { "path": "facts.nearest_blocks.nether_portal.type", "equals": "nether_portal" } }
  ],
  "evaluation": null
}
