# Copy to bridge.env and fill in. Never commit bridge.env.
# Path to Agent-37's bridge/server.js (its node_modules must be installed: cd bridge && npm install)
# Optional. Leave unset to use the in-repo bridge (bridge/server.js).
# A37_BRIDGE_SERVER=C:/path/to/Agent-37/bridge/server.js
# Minecraft server the bots join
A37_MC_HOST=localhost
A37_MC_PORT=25565
# Optional: Creative/Survival toggle on each bot's control page (uses the server's RCON).
# Either point at the server folder (the launcher reads enable-rcon, rcon.port and rcon.password from server.properties)...
# A37_SERVER_DIR=C:/path/to/minecraft-server
# ...or set them directly. Leave all unset and the toggle shows as disabled.
# A37_RCON_HOST=127.0.0.1
# A37_RCON_PORT=25575
# A37_RCON_PASSWORD=<your-rcon-password>
